{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "assignees": ["gregpakes"],
  "extends": ["config:recommended"],

  "argocd": {
    "managerFilePatterns": ["/argocd/apps/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/argocd/infrastructure/.+\\.yaml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/argocd/infrastructure/.+/values\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^argocd/apps/rancher\\.yaml$/"],
      "matchStrings": [
        "repoURL:\\s+https://releases\\.rancher\\.com/server-charts/stable\\s+chart:\\s+rancher\\s+targetRevision:\\s+(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "rancher",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://releases.rancher.com/server-charts/stable",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^argocd/infrastructure/arc-runners/values-.+\\.yaml$/"],
      "matchStrings": [
        "image:\\s+(?<depName>ghcr\\.io/actions/actions-runner):(?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "The controller chart ships the CRDs the scale-set chart renders against, so the two must move in lockstep. Bumping only the scale sets (#322) left Argo unable to diff them: .spec.listenerConfig was not in the 0.14.2 CRD schema.",
      "matchPackageNames": ["ghcr.io/actions/actions-runner-controller-charts/**"],
      "groupName": "actions-runner-controller charts"
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["longhorn"],
      "prPriority": 10
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/nzbget"],
      "versioning": "regex:^version-v(?<major>\\d+)\\.(?<minor>\\d+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/lukegus/termix"],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/linuxserver/qbittorrent"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-libtorrentv1$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["lscr.io/linuxserver/plex"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?(?:-[A-Za-z0-9]+)?(?:-ls(?<revision>\\d+))?$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/haveagitgat/tdarr", "docker.io/haveagitgat/tdarr_node"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["cloudflare/cloudflared", "ghcr.io/openclaw/openclaw"],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d+)$"
    },
    {
      "description": "Pinned by hand from the LapSmith `CI · Track Manager image` workflow, like the CI runner images: its sha- tags are not versions, and an image swapped under the operator console should be a decision, not a bot PR.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/gregpakes/lapsmith-track-manager"],
      "enabled": false
    },
    {
      "description": "Descheduler minor versions track Kubernetes minors. Keep it at or below the cluster's k3s minor (1.36, itself capped by Rancher 2.15) and raise this cap together with k3s.",
      "matchDatasources": ["helm"],
      "matchPackageNames": ["descheduler"],
      "allowedVersions": "<0.37.0"
    }
  ]
}
