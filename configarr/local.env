# 1Password references for running the exporter or Configarr on a workstation:
#   op run --env-file configarr/local.env -- <command>
# Only op:// references belong here. The cluster reads the same items through
# argocd/infrastructure/servarr/configarr/externalsecret.yaml.
RADARR_API_KEY=op://Homelab/servarr-api-keys/RADARR_API_KEY
SONARR_API_KEY=op://Homelab/servarr-api-keys/SONARR_API_KEY
NZBGET_USERNAME=op://Homelab/nzbget/CONTROL_USERNAME
NZBGET_PASSWORD=op://Homelab/nzbget/CONTROL_PASSWORD
QBITTORRENT_USERNAME=op://Homelab/qbittorrent/WEBUI_USERNAME
QBITTORRENT_PASSWORD=op://Homelab/qbittorrent/WEBUI_PASSWORD
