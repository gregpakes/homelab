# keepalived settings for dns2, the standby VIP holder.
# Applied by docker/stacks/technitium/keepalived/install.sh. dns1's file must agree
# on VIP, VIP_PREFIX and VRID, with NODE_IP/PEER_IP swapped.

NODE_NAME=dns2
# Proposed addresses - see dns1/keepalived.env.
NODE_IP=172.16.51.54
PEER_IP=172.16.51.53
PRIORITY=100

VIP=172.16.51.67
VIP_PREFIX=24
VRID=67
VIP_ENABLED=false

# Normally found from NODE_IP; set to override.
# INTERFACE=eth0
