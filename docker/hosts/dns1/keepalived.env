# keepalived settings for dns1, the preferred VIP holder.
# Applied by docker/stacks/technitium/keepalived/install.sh. dns2's file must agree
# on VIP, VIP_PREFIX and VRID, with NODE_IP/PEER_IP swapped.

NODE_NAME=dns1
# Proposed addresses - pick free ones on the 172.16.51.0/24 VLAN, reserve them in
# UniFi, and update both env files. install.sh refuses to run unless NODE_IP is
# actually on the host.
NODE_IP=172.16.51.53
PEER_IP=172.16.51.54
PRIORITY=150

# The current Pi-hole address, so DHCP, static clients and the Tailscale route
# need no change. Not free until cutover - keep VIP_ENABLED=false until then.
VIP=172.16.51.67
VIP_PREFIX=24
VRID=67
VIP_ENABLED=false

# Normally found from NODE_IP; set to override.
# INTERFACE=eth0
